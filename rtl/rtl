module spi_rx (
input  wire clk,
input  wire rst,
input  wire sclk,
input  wire cs,
input  wire mosi,

output reg  [7:0] rx_data,
output reg        rx_done
);

localparam IDLE     = 2'd0,
START    = 2'd1,
TRANSFER = 2'd2,
STOP     = 2'd3;

reg [1:0] state;
reg [2:0] bit_count;
reg [7:0] shift_reg;
reg sclk_d;

always @(posedge clk or posedge rst) begin
if (rst) begin
state     <= IDLE;
bit_count <= 0;
shift_reg <= 0;
rx_data   <= 0;
rx_done   <= 0;
sclk_d    <= 0;
end else begin
sclk_d  <= sclk;
rx_done <= 0;

case (state)

IDLE: begin
bit_count <= 0;
if (cs == 0)
state <= START;
end

START: begin
shift_reg <= 0;
bit_count <= 0;
state <= TRANSFER;
end

TRANSFER: begin
if (cs == 1)
state <= IDLE;
else if (sclk == 1 && sclk_d == 0) begin
shift_reg <= {shift_reg[6:0], mosi};
bit_count <= bit_count + 1;

if (bit_count == 3'd7)
state <= STOP;
end
end

STOP: begin
rx_data <= shift_reg;
rx_done <= 1;
state   <= IDLE;
end

endcase
end
end

endmodule
