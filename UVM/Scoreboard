class spi_rx_scoreboard extends uvm_scoreboard;

    `uvm_component_utils(spi_rx_scoreboard)

    uvm_analysis_imp #(
        spi_rx_sequence_item,
        spi_rx_scoreboard
    ) analysis_export;

    int pass_count;
    int fail_count;


    function new(
        string name = "spi_rx_scoreboard",
        uvm_component parent = null
    );

        super.new(name, parent);

        analysis_export =
            new("analysis_export", this);

        pass_count = 0;
        fail_count = 0;

    endfunction


    virtual function void write(
        spi_rx_sequence_item item
    );

        bit [7:0] expected;

        expected = 8'b1010_1001;


        if (item.received_data === expected) begin

            pass_count++;

            `uvm_info(
                "SPI_PASS",
                $sformatf(
                    "SPI RX PASS: Expected=%8b Received=%8b",
                    expected,
                    item.received_data
                ),
                UVM_MEDIUM
            )

        end
        else begin

            fail_count++;

            `uvm_error(
                "SPI_FAIL",
                $sformatf(
                    "SPI RX FAIL: Expected=%8b Received=%8b",
                    expected,
                    item.received_data
                )
            )

        end

    endfunction


    function void report_phase(uvm_phase phase);

        super.report_phase(phase);

        `uvm_info(
            "SPI_SUMMARY",
            $sformatf(
                "SPI RX VERIFICATION: PASS=%0d FAIL=%0d",
                pass_count,
                fail_count
            ),
            UVM_NONE
        )

    endfunction

endclass
