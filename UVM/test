class spi_rx_test extends uvm_test;

    `uvm_component_utils(spi_rx_test)

    spi_rx_env env;


    function new(
        string name = "spi_rx_test",
        uvm_component parent = null
    );

        super.new(name, parent);

    endfunction


    function void build_phase(uvm_phase phase);

        super.build_phase(phase);

        env =
            spi_rx_env::type_id::create(
                "env",
                this
            );

    endfunction


    virtual task run_phase(uvm_phase phase);

        spi_rx_sequence seq;

        phase.raise_objection(this);


        seq =
            spi_rx_sequence::type_id::create(
                "seq"
            );


        seq.start(
            env.agent.sequencer
        );


        #200;


        phase.drop_objection(this);

    endtask

endclass
